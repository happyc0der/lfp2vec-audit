# data and heavy artefacts
# Anchored to the repository root on purpose: a bare `data/` also matches the source package
# lfpaudit/data/, which silently kept it out of the first commit.
/data/
*.nwb
*.cbin
*.ch
*.meta
*.npy.gz
*.memmap

# environments
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# run outputs that are too big to commit (metrics.json/manifest.json are kept)
results/**/*.parquet
results/**/*.npy
wandb/

# os
.DS_Store
